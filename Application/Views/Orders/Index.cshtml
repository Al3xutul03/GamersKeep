@model IReadOnlyList<BusinessLogic.Models.Order.OrderListingDto>

@{
    ViewData["Title"] = "Comenzile mele";
}

<div class="page-head">
    <h1 class="page-head__title">Comenzile mele</h1>
    @if (Model.Count > 0)
    {
        <p class="page-head__sub">@Model.Count @(Model.Count == 1 ? "comandă" : "comenzi")</p>
    }
</div>

@if (TempData["OrderMessage"] is string message)
{
    <div class="alert alert--success" role="status">@message</div>
}

@if (TempData["OrderError"] is string error)
{
    <div class="alert alert--error" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <div class="catalog-empty">
        <div class="catalog-empty__icon">📦</div>
        <h3>Nu ai nicio comandă încă</h3>
        <p class="hero__text">Când plasezi o comandă, o vei găsi aici, cu statusul ei.</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn--primary">Vezi catalogul</a>
    </div>
}
else
{
    <div class="orders-list">
        @foreach (var order in Model)
        {
            <article class="order-card">
                <header class="order-card__head">
                    <div>
                        <a class="order-card__number" asp-controller="Orders" asp-action="Details" asp-route-orderNumber="@order.OrderNumber">@order.OrderNumber</a>
                        <div class="order-card__date">@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    <partial name="_OrderStatusBadge" model="order.Status" />
                </header>

                <ul class="order-card__items">
                    @foreach (var item in order.Items.Take(3))
                    {
                        <li>
                            <span>@item.ProductName × @item.Quantity</span>
                            <span>@item.TotalPrice.ToString("F2") RON</span>
                        </li>
                    }
                    @if (order.Items.Count > 3)
                    {
                        <li class="order-card__more">+ @(order.Items.Count - 3) alte produse</li>
                    }
                </ul>

                <footer class="order-card__foot">
                    <strong>Total: @order.Total.ToString("F2") RON</strong>
                    <a class="btn btn--ghost btn--sm" asp-controller="Orders" asp-action="Details" asp-route-orderNumber="@order.OrderNumber">Detalii</a>
                </footer>
            </article>
        }
    </div>
}