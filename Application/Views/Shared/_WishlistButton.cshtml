@model Application.Models.WishlistButtonModel

@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var label = Model.Active ? "Elimină din wishlist" : "Adaugă în wishlist";
    var css = "wish-btn" + (Model.Active ? " wish-btn--active" : "") + (Model.ShowLabel ? " wish-btn--label" : "");
}

@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wish-form">
        <input type="hidden" name="productId" value="@Model.ProductId" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit" class="@css" title="@label" aria-label="@label" aria-pressed="@(Model.Active ? "true" : "false")">
            <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
            @if (Model.ShowLabel)
            {
                <span>@label</span>
            }
        </button>
    </form>
}
else
{
    <a asp-controller="Account" asp-action="Login" class="@css" title="Autentifică-te pentru wishlist" aria-label="Autentifică-te pentru wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
        @if (Model.ShowLabel)
        {
            <span>Adaugă în wishlist</span>
        }
    </a>
}