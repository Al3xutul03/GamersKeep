@{
    var appName = "Botboard"; 
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? appName : $"{title} · {appName}")</title>
    <script>
        try {
            var t = localStorage.getItem('theme');
            if (t) document.documentElement.setAttribute('data-theme', t);
        } catch (e) { }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth">
        <aside class="auth__panel" aria-hidden="true">
            <a class="brand brand--light" asp-controller="Home" asp-action="Index" tabindex="-1">@appName</a>
            <div class="auth__panel-body">
                <p class="auth__sub">Settings, users and status, without touching the server.</p>
            </div>
        </aside>

        <main id="main" class="auth__main">
            <div class="auth__top">
                <a class="brand auth__brand-mobile" asp-controller="Home" asp-action="Index">@appName</a>
                <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
                    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 1.5a7.5 7.5 0 1 0 0 15V1.5Z" fill="currentColor"/><circle cx="9" cy="9" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
            </div>
            <div class="auth__card">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
