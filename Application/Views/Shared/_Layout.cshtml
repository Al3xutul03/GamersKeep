@{
    var appName = "Gamer's Keep";
    var title = ViewData["Title"] as string;
    var path = Context.Request.Path.Value ?? "/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? appName : $"{title} · {appName}")</title>
    <script>
            try {
                var t = localStorage.getItem('theme');
                if (t) document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" asp-controller="Home" asp-action="Index">@appName</a>

            <button class="icon-btn nav-toggle" type="button" aria-expanded="false"
                    aria-controls="site-nav" data-nav-toggle aria-label="Open menu">
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
            </button>

            <nav id="site-nav" class="site-nav" aria-label="Main">
                <a class="site-nav__link" asp-controller="Home" asp-action="Index"
                   aria-current="@(path == "/" ? "page" : null)">Home</a>

                <a class="site-nav__link" asp-controller="Catalog" asp-action="Index"
                   aria-current="@(path.StartsWith("/Catalog") ? "page" : null)">Catalog</a>

                <div class="site-nav__end">
                    <a class="icon-btn" asp-controller="Cart" asp-action="Index" aria-label="Vezi coșul de cumpărături" style="text-decoration: none;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                    </a>

                    <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
                        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 1.5a7.5 7.5 0 1 0 0 15V1.5Z" fill="currentColor" /><circle cx="9" cy="9" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="site-nav__user">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn--ghost btn--sm" type="submit">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn--ghost btn--sm" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="btn btn--primary btn--sm" asp-controller="Account" asp-action="Register">Create account</a>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main id="main" class="container page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <span>&copy; @DateTime.UtcNow.Year @appName</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>