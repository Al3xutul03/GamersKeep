@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="hero">
    <h1 class="hero__title">Something went wrong</h1>
    <p class="hero__text">The request failed. Go back and try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="field__hint">Request ID: <code>@Model.RequestId</code></p>
    }
    <div class="hero__actions">
        <a class="btn btn--primary" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</section>
