@model Application.Models.CartViewModel

@functions {
    static string Initials(string name) =>
        string.Concat(
            name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Where(w => char.IsLetterOrDigit(w[0]))
                .Take(2)
                .Select(w => char.ToUpperInvariant(w[0])));
}

@{
    ViewData["Title"] = "Coșul tău";
    var itemCount = Model?.Items.Sum(i => i.Quantity) ?? 0;
}

<div class="page-head">
    <h1 class="page-head__title">Coșul tău</h1>
    @if (itemCount > 0)
    {
        <p class="page-head__sub">@itemCount @(itemCount == 1 ? "produs" : "produse") în coș</p>
    }
</div>

@if (TempData["CheckoutError"] is string checkoutError)
{
    <div class="alert alert--error" role="alert">@checkoutError</div>
}

@if (Model == null || !Model.Items.Any())
{
    <div class="catalog-empty">
        <div class="catalog-empty__icon">🛒</div>
        <h3>Coșul tău este gol</h3>
        <p class="hero__text">Alege jocurile tale preferate din catalog și adaugă-le în coș.</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn--primary">Vezi catalogul</a>
    </div>
}
else
{
    <div class="cart-layout">
        <div class="cart-items">
            @foreach (var item in Model.Items)
            {
                <article class="cart-item">
                    <a class="cart-item__thumb" asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" aria-label="@item.ProductName">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                        }
                        else
                        {
                            <div class="cover" data-tone="@(item.ProductId % 6)">
                                <span class="cover__mark">@Initials(item.ProductName)</span>
                            </div>
                        }
                    </a>

                    <div>
                        <h3 class="cart-item__name">
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" style="color: inherit; text-decoration: none;">@item.ProductName</a>
                        </h3>
                        <p class="cart-item__price">@item.UnitPrice.ToString("F2") RON / buc.</p>
                    </div>

                    <span class="cart-item__quantity">Cantitate: @item.Quantity</span>

                    <strong class="cart-item__total">@item.TotalPrice.ToString("F2") RON</strong>

                    <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="btn btn--danger btn--sm" aria-label="Șterge @item.ProductName din coș">Șterge</button>
                    </form>
                </article>
            }
        </div>

        <aside class="cart-summary">
            <h2 class="cart-summary__title">Rezumat comandă</h2>

            <div class="summary-row">
                <span>Produse (@itemCount)</span>
                <strong>@Model.GrandTotal.ToString("F2") RON</strong>
            </div>
            <div class="summary-row">
                <span>Livrare</span>
                <span>se alege la pasul următor</span>
            </div>
            <div class="summary-row summary-row--total">
                <span>Total</span>
                <strong>@Model.GrandTotal.ToString("F2") RON</strong>
            </div>

            <a asp-controller="Checkout" asp-action="Index" class="btn btn--primary btn--lg btn--block" style="margin-top: 1.5rem;">Spre finalizare comandă</a>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn--ghost btn--block">Continuă cumpărăturile</a>
        </aside>
    </div>
}