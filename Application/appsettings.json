{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AutoMapper": {
    "LicenseKey": "YOUR_LICENSE_KEY"
  },
  "MediaFiles": {
    "Path": "wwwroot/media",
    "Types": {
      "Image": {
        "Path": "wwwroot/media/images",
        "MaxSizeMB": 5,
        "AllowedExtensions": [ ".webp", ".jpg", ".jpeg", ".png", ".gif" ]
      }
    }
  },
  "ConnectionStrings": {
    "DbDevConnection": "server=localhost;port=3306;database=gamerskeep;user=YOUR_USERNAME;password=YOUR_LOCAL_PASSWORD"
  },
  "Jwt": {
    "Key": "put-a-long-random-string-of-at-least-32-characters-here",
    "Issuer": "gamerskeep",
    "Audience": "gamerskeep",
    "ExpirationTimeMinutes": "60"
  }
  ,
  "Stripe": {
    "PublishableKey": "pk_test_YOUR_STRIPE_PUBLISHABLE_KEY",
    "SecretKey": "sk_test_YOUR_STRIPE_SECRET_KEY",
    "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET",
    "SuccessUrl": "http://localhost:8080/Checkout/Confirmation?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:8080/Checkout/Cancel?orderId={ORDER_ID}"
  }
  ,
  "Mailtrap": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Username": "YOUR_MAILTRAP_USERNAME",
    "Password": "YOUR_MAILTRAP_PASSWORD",
    "FromEmail": "no-reply@gamerskeep.com",
    "FromName": "GamersKeep"
  }
}